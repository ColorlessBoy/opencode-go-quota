{
  "name": "opencode-go-quota",
  "version": "0.1.1",
  "description": "OpenCode TUI plugin: /quota dialog showing OpenCode Go rolling/weekly/monthly usage via the official usage API (curl, no browser cookies)",
  "type": "module",
  "license": "MIT",
  "author": "penglingwei",
  "repository": "https://github.com/ColorlessBoy/opencode-go-quota",
  "homepage": "https://github.com/ColorlessBoy/opencode-go-quota#readme",
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "tui",
    "plugin",
    "quota",
    "opencode-go",
    "usage"
  ],
  "engines": {
    "node": ">=18",
    "opencode": ">=1.14.0"
  },
  "scripts": {
    "test": "node --test test/smoke.test.mjs"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  }
}
